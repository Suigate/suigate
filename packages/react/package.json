{
  "name": "@suigate/react",
  "version": "0.1.0",
  "description": "A Sui dApp Kit paywall for suigate entitlements",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE.md"
  ],
  "suigateRisk": {
    "aiGenerated": true,
    "humanAuditStatus": "not-audited",
    "notice": "NOTICE.md"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write src test *.json *.ts",
    "format:check": "prettier --check src test *.json *.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mysten/dapp-kit-react": "2.1.37",
    "@mysten/sui": "2.33.2",
    "@suigate/core": "0.1.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@mysten/wallet-standard": "0.21.31",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
