{
  "name": "@suigate/core",
  "version": "0.1.0",
  "description": "Sui-native entitlement queries, transactions, and wallet authentication",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "risk.mjs",
    "risk.d.mts",
    "scripts/install-warning.mjs",
    "README.md",
    "NOTICE.md",
    "LICENSE.md"
  ],
  "suigateRisk": {
    "aiGenerated": true,
    "humanAuditStatus": "not-audited",
    "notice": "NOTICE.md"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./risk": {
      "types": "./risk.d.mts",
      "import": "./risk.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/install-warning.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "check": "npm run build && npm test && npm run format:check",
    "format:check": "prettier --check src test package.json tsconfig.json tsconfig.test.json",
    "format": "prettier --write src test package.json tsconfig.json tsconfig.test.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mysten/sui": "2.33.2"
  },
  "dependencies": {
    "@mysten/bcs": "2.1.2",
    "@mysten/payment-kit": "0.2.31"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "ajv": "8.20.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
