{
  "name": "@suigate/express",
  "version": "0.1.0",
  "description": "Replay-safe Sui entitlement authorization for Express",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE.md"
  ],
  "suigateRisk": {
    "aiGenerated": true,
    "humanAuditStatus": "not-audited",
    "notice": "NOTICE.md"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write src test *.json *.ts",
    "format:check": "prettier --check src test *.json *.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "on-headers": "1.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.18.6",
    "@types/on-headers": "1.0.4",
    "@types/supertest": "7.2.1",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@suigate/core": "0.1.0",
    "express": "5.2.1"
  },
  "license": "MIT"
}
